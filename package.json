{
  "name": "copilotops",
  "version": "1.2.0",
  "description": "CopilotOps Framework: private GitHub Copilot prompts, skills, instructions, validation, and setup tooling for invited teams.",
  "type": "commonjs",
  "bin": {
    "copilotops": "./bin/copilotops.js"
  },
  "private": true,
  "scripts": {
    "start": "node ./bin/copilotops.js",
    "install:target": "node ./bin/copilotops.js install",
    "health": "node ./bin/copilotops.js health",
    "doctor": "node ./bin/copilotops.js doctor",
    "validate": "node ./bin/copilotops.js validate",
    "test:local": "node ./bin/copilotops.js --help"
  },
  "keywords": [
    "github-copilot",
    "copilot",
    "prompts",
    "skills",
    "developer-tools",
    "ai-engineering"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  }
}
